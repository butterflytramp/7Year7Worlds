      </ol>
    </div>
    <div class="f-end">
      <span>Redesigning our planet — bit by bit, step by step</span>
      <span>World 03 / 07</span>
    </div>
  </div>
</footer>
<script>window.__MAMMOTH="data:image/webp;base64,";</script>
<script>
/* ============================================================
   0 · CORE
   ============================================================ */
(function(){
'use strict';
var RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
if(RM) document.documentElement.classList.add('rm');

var clamp=function(v,a,b){return v<a?a:(v>b?b:v);};
var lerp=function(a,b,t){return a+(b-a)*t;};
var smoo=function(a,b,x){var t=clamp((x-a)/(b-a),0,1);return t*t*(3-2*t);};
var $=function(s,r){return (r||document).querySelector(s);};
var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));};
var DPR=function(cap){return Math.min(window.devicePixelRatio||1, cap||2);};

var S = {              /* shared scroll state */
  y:0, sy:0, vel:0, svel:0, h:0, j:0, sj:0, mode:0, fire:0,
  mx:0, my:0, smx:0, smy:0, envVisible:true, t:0
};
var CHOICE = {albedo:0, water:0, canopy:0, agree:0, picked:0};

/* grain texture */
(function(){
  var c=document.createElement('canvas'); c.width=c.height=180;
  var x=c.getContext('2d'), d=x.createImageData(180,180), p=d.data;
  for(var i=0;i<p.length;i+=4){ var v=(Math.random()*255)|0; p[i]=p[i+1]=p[i+2]=v; p[i+3]=26; }
  x.putImageData(d,0,0);
  document.documentElement.style.setProperty('--grain','url('+c.toDataURL()+')');
})();

/* ============================================================
   1 · WEBGL ENVIRONMENT
   ============================================================ */
var GL = (function(){
  var cv=$('#gl'), gl=null, prog=null, U={}, ok=false, W=0, H=0;

  var VS = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';

  var FS = [
'precision highp float;',
'uniform vec2 uRes; uniform float uT,uJ,uFire,uMode,uVel; uniform vec2 uM;',
'uniform vec4 uCh;',
'float h21(vec2 p){p=fract(p*vec2(123.34,345.45));p+=dot(p,p+34.345);return fract(p.x*p.y);}',
'float n2(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);',
' float a=h21(i),b=h21(i+vec2(1,0)),c=h21(i+vec2(0,1)),d=h21(i+vec2(1,1));',
' return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);}',
'float fbm(vec2 p){float s=0.,a=.5;for(int i=0;i<4;i++){s+=a*n2(p);p*=2.03;a*=.5;}return s;}',
'float rfbm(vec2 p){float s=0.,a=.5;for(int i=0;i<4;i++){s+=a*(1.-abs(n2(p)*2.-1.));p*=2.04;a*=.5;}return s;}',

/* palette */
'const vec3 VOID=vec3(0.016,0.063,0.106);',
'const vec3 DEEP=vec3(0.039,0.129,0.220);',
'const vec3 MID =vec3(0.090,0.275,0.420);',
'const vec3 BLUE=vec3(0.369,0.576,0.745);',
'const vec3 PALE=vec3(0.725,0.831,0.910);',
'const vec3 FROST=vec3(0.910,0.945,0.968);',
'const vec3 EMBER=vec3(1.000,0.541,0.239);',

/* ---------- exterior glacier ---------- */
'vec3 exterior(vec2 uv, vec2 su, float j, out float cover){',
' float hz=0.545;',
' vec3 col=mix(mix(PALE,FROST,0.55), mix(BLUE,MID,0.30), smoothstep(0.30,1.05,uv.y));',
' col=mix(col, vec3(0.94,0.96,0.97), pow(max(0.,1.-length((su-vec2(-0.30,0.10))*vec2(0.75,1.25))),2.6)*0.55);',
' float push=j*j*2.2;',
' for(int i=0;i<5;i++){',
'  float d=float(i);',
'  float sc=1.0+push*(0.35+d*0.42);',
'  float px=(uv.x-0.5)*(0.85+d*0.60)*sc + uM.x*0.010*(d+1.0) + d*4.3;',
'  float amp=0.030+d*0.026;',
'  float base=hz-0.115+d*0.030 + push*(0.030+d*0.075);',
'  float hh=base+amp*rfbm(vec2(px*1.5, 2.0+d*9.0));',
'  float m=smoothstep(hh+0.0035,hh-0.0035,uv.y);',
'  vec3 c=mix(mix(FROST,PALE,0.35), mix(BLUE,DEEP,0.30), 0.10+d*0.20);',
'  col=mix(col,c,m);',
'  col=mix(col, mix(PALE,FROST,0.6), 0.16*smoothstep(hh+0.085,hh,uv.y)*smoothstep(hh-0.05,hh+0.01,uv.y));',
' }',
/* central iceberg — grows exponentially so the camera flies into it */
' float zb=0.46*exp(j*3.55);',
' vec2 bp=(su-vec2(0.0,0.055))/zb;',
' float prof=0.78*exp(-abs(bp.x)*1.30)+0.18*exp(-abs(bp.x)*0.34);',
' float jag=0.24*rfbm(vec2(bp.x*2.6+3.7,1.4))*exp(-abs(bp.x)*0.42);',
' float topE=prof+jag-0.34;',
' float sedge=0.012*max(0.40,zb);',
' float berg=smoothstep(sedge,-sedge,bp.y-topE);',
' berg*=smoothstep(2.15,1.25,abs(bp.x));',
' float fac=fbm(bp*2.6+vec2(1.7,0.4));',
' float fis=rfbm(bp*4.2+vec2(5.0,2.0));',
' float fall=clamp((topE-bp.y)*1.5,0.0,1.0);',
' vec3 bc=mix(mix(FROST,PALE,0.18), mix(BLUE,MID,0.60), smoothstep(0.28,0.92,fac)*0.76);',
' bc=mix(bc, FROST, smoothstep(0.78,1.0,fis)*0.62);',
' bc=mix(bc, mix(MID,DEEP,0.55), smoothstep(0.06,0.85,fall)*0.52);',
' bc=mix(bc, FROST, smoothstep(0.085,0.0,abs(bp.y-topE))*0.60);',
' float fmask=smoothstep(0.62,0.04,fall)*smoothstep(0.04,0.30,prof);',
' vec2 bw=bp+0.16*vec2(fbm(bp*3.1+2.0),fbm(bp*3.1+8.0));',
' float fx1=abs(fract(dot(bw,vec2(0.86,0.51))*2.2)-0.5);',
' float fx2=abs(fract(dot(bw,vec2(-0.62,0.78))*2.8+0.3)-0.5);',
' bc=mix(bc, FROST, smoothstep(0.16,0.0,fx1)*0.20*fmask);',
' bc=mix(bc, mix(MID,DEEP,0.4), smoothstep(0.10,0.0,fx2)*0.24*fmask);',
' col=mix(col,bc,berg);',
' cover=berg;',
/* ground snow */
' float gm=smoothstep(hz-0.055,hz-0.075,uv.y)*(1.0-smoothstep(0.16,0.36,j));',
' vec3 gc=mix(FROST, PALE, 0.25+0.5*fbm(vec2(uv.x*7.0, uv.y*22.0)));',
' col=mix(col,gc,gm*(1.0-berg));',
/* drifting mist bands */
' float mist=fbm(vec2(uv.x*2.2 - uT*0.010, uv.y*5.0 + uT*0.004));',
' col=mix(col, mix(FROST,PALE,0.4), 0.20*smoothstep(0.42,0.85,mist)*smoothstep(hz+0.16,hz-0.12,uv.y));',
' return col;',
'}',

/* ---------- inside the ice ---------- */
'vec3 interior(vec2 su, float j, out float crk){',
' float z=(j-0.30)*7.2;',
' vec2 p=su*1.25+vec2(uM.x*0.05,uM.y*0.05);',
' vec2 rf=vec2(fbm(p*2.4+uT*0.05), fbm(p*2.4+9.1-uT*0.04));',
' p+=(rf-0.5)*0.055;',
' float cr=0.0; float bub=0.0;',
' for(int k=0;k<2;k++){',
'  float f=fract(z*0.5+float(k)*0.5);',
'  float sc=exp2(f)*0.9;',
'  float w=sin(3.14159*f);',
'  vec2 q=p*sc+float(k)*17.0;',
'  vec2 wp=vec2(fbm(q*1.15), fbm(q*1.15+6.3));',
'  cr+=w*rfbm(q*2.1+wp*1.5);',
'  bub+=w*smoothstep(0.955,1.0,n2(q*11.0+float(k)*5.0));',
' }',
' crk=smoothstep(0.845,1.02,cr);',
' float veinF=smoothstep(0.90,1.03,cr*0.62+0.42*rfbm(p*7.4+vec2(uT*0.02,0.0)));',
' vec3 col=mix(VOID, DEEP, smoothstep(-0.85,0.85,su.y));',
' col=mix(col, mix(DEEP,MID,0.50), smoothstep(0.66,0.98,cr)*0.30);',
' col=mix(col, mix(PALE,FROST,0.35), crk*0.88);',
' col=mix(col, FROST, veinF*0.45);',
' col+=BLUE*bub*0.85;',
' col+=mix(MID,BLUE,0.5)*pow(max(0.,1.0-abs(su.x)*0.80),4.0)*(0.14+0.24*smoothstep(0.9,-0.6,su.y));',
' col+=FROST*0.10*pow(max(0.,1.0-length(su*vec2(0.55,1.0))),3.0);',
' return col;',
'}',

/* ---------- closing planet ---------- */
'vec3 planet(vec2 su){',
' vec3 sky=mix(vec3(0.012,0.043,0.078), vec3(0.031,0.098,0.157), smoothstep(-1.0,1.0,su.y));',
' float st=smoothstep(0.9965,1.0,n2(su*140.0));',
' sky+=vec3(0.55,0.70,0.85)*st*0.55;',
' su-=vec2(0.0,0.40); float R=0.235; float r=length(su);',
' float d=smoothstep(R,R-0.0035,r);',
' float zc=sqrt(max(0.0001,1.0-clamp(r*r/(R*R),0.,1.)));',
' vec3 nrm=normalize(vec3(su/R, zc));',
' vec2 sp=su/R;',
' float spin=uT*0.012;',
' float lf=fbm(sp*2.9+vec2(2.2+spin,1.1))+0.22*fbm(sp*7.4+vec2(9.0+spin,4.0));',
' float land=smoothstep(0.60,0.74,lf);',
' vec3 sea=mix(vec3(0.075,0.200,0.330), vec3(0.110,0.380,0.590), uCh.y);',
' vec3 gnd=mix(vec3(0.300,0.268,0.205), vec3(0.180,0.470,0.290), uCh.z);',
' vec3 s=mix(sea,gnd,land);',
' float pol=smoothstep(0.52,1.0,abs(sp.y));',
' float roof=smoothstep(0.72,0.95,n2(sp*16.0))*land;',
' s=mix(s, vec3(0.93,0.96,0.98), clamp(pol*(0.42+0.52*uCh.x)+roof*uCh.x*0.62,0.,1.));',
' float cloud=smoothstep(0.56,0.82,fbm(sp*4.2+vec2(spin*2.4,7.0)));',
' s=mix(s, vec3(0.92,0.95,0.98), cloud*0.34);',
' float lam=clamp(dot(nrm,normalize(vec3(-0.42,0.34,0.84))),0.,1.);',
' s*=0.30+1.05*pow(lam,0.70);',
' s+=vec3(0.30,0.46,0.62)*pow(max(0.0,lam),9.0)*(1.0-land)*0.35;',
' float rim=smoothstep(R,R-0.055,r)*smoothstep(R-0.10,R-0.004,r);',
' s+=mix(vec3(0.30,0.55,0.80),vec3(0.52,0.78,1.00),uCh.w)*rim*0.80;',
' vec3 col=mix(sky,s,d);',
' col+=mix(vec3(0.18,0.38,0.60),vec3(0.34,0.60,0.88),uCh.w)*0.50*smoothstep(R*2.05,R,r)*(1.0-d);',
' return col;',
'}',

'void main(){',
' vec2 uv=gl_FragCoord.xy/uRes;',
' vec2 su=(gl_FragCoord.xy-0.5*uRes)/uRes.y*2.0;',
' vec3 col;',
' if(uMode>0.995){ col=planet(su); }',
' else {',
'  float j=uJ; float crk=0.0; float cover=0.0;',
'  vec3 ext=vec3(0.0); vec3 itr=vec3(0.0);',
'  float inside=smoothstep(0.30,0.47,j);',
'  bool needExt = j<0.56; bool needInt = j>0.14;',
'  if(needExt) ext=exterior(uv,su,j,cover);',
'  if(needInt) itr=interior(su,j,crk);',
'  inside=max(inside, cover*smoothstep(0.19,0.38,j));',
'  inside=clamp(inside,0.0,1.0);',
'  if(!needExt) col=itr; else if(!needInt) col=ext; else col=mix(ext,itr,inside);',
/* fire */
'  float fl=uFire*(0.80+0.20*n2(vec2(uT*3.1,0.0))+0.12*n2(vec2(uT*7.7,3.0)));',
'  float fd=length((su-vec2(0.0,-0.46))*vec2(0.85,1.25));',
'  col+=EMBER*fl*pow(max(0.,1.0-fd*0.72),3.4)*1.05;',
'  col=mix(col, col*vec3(1.06,0.99,0.93)+EMBER*0.06, fl*0.55);',
/* whiteout — brightness travels along the cracks, we pass through the material */
'  float wo=smoothstep(0.865,0.985,j);',
'  float rr=length(su*vec2(0.92,1.12));',
'  float front=smoothstep(wo*2.9, wo*2.9-0.85, rr+ (0.5-crk)*0.42*(1.0-wo));',
'  vec3 thaw=mix(vec3(0.955,0.972,0.982), PALE, crk*0.17+0.05);',
'  thaw=mix(thaw, vec3(0.961,0.969,0.973), smoothstep(0.96,1.0,j));',
'  col=mix(col,thaw,clamp(front,0.,1.));',
'  if(uMode>0.0) col=mix(col,planet(su),uMode);',
' }',
/* vignette + subtle chroma */
' float vg=1.0-0.30*pow(length((uv-0.5)*vec2(1.05,1.0))*1.42,2.4);',
' col*=vg;',
' col+=(h21(gl_FragCoord.xy+uT)-0.5)*0.016;',
' gl_FragColor=vec4(col,1.0);',
'}'].join('\n');

  function sh(t,src){ var s=gl.createShader(t); gl.shaderSource(s,src); gl.compileShader(s);
    if(!gl.getShaderParameter(s,gl.COMPILE_STATUS)){ console.warn(gl.getShaderInfoLog(s)); return null; } return s; }

  function init(){
    try{ gl=cv.getContext('webgl',{antialias:false,alpha:false,powerPreference:'high-performance'})
              ||cv.getContext('experimental-webgl'); }catch(e){}
    if(!gl) return false;
    var v=sh(gl.VERTEX_SHADER,VS), f=sh(gl.FRAGMENT_SHADER,FS);
    if(!v||!f) return false;
    prog=gl.createProgram(); gl.attachShader(prog,v); gl.attachShader(prog,f); gl.linkProgram(prog);
    if(!gl.getProgramParameter(prog,gl.LINK_STATUS)){ console.warn(gl.getProgramInfoLog(prog)); return false; }
    gl.useProgram(prog);
    var b=gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER,b);
    gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,3,-1,-1,3]),gl.STATIC_DRAW);
    var a=gl.getAttribLocation(prog,'a'); gl.enableVertexAttribArray(a); gl.vertexAttribPointer(a,2,gl.FLOAT,false,0,0);
    ['uRes','uT','uJ','uFire','uMode','uVel','uM','uCh'].forEach(function(n){ U[n]=gl.getUniformLocation(prog,n); });
    ok=true; resize(); return true;
  }
  var qual=1.0;
  function setQuality(q){ if(Math.abs(q-qual)<0.06) return; qual=q; resize(); }
  function resize(){
    if(!ok) return;
    var d=DPR(1.55)*qual;
    W=Math.round(cv.clientWidth*d); H=Math.round(cv.clientHeight*d);
    if(W<2||H<2) return;
    cv.width=W; cv.height=H; gl.viewport(0,0,W,H);
  }
  function draw(){
    if(!ok) return;
    gl.uniform2f(U.uRes,W,H);
    gl.uniform1f(U.uT,S.t);
    gl.uniform1f(U.uJ,S.sj);
    gl.uniform1f(U.uFire,S.fire);
    gl.uniform1f(U.uMode,S.mode);
    gl.uniform1f(U.uVel,S.svel);
    gl.uniform2f(U.uM,S.smx,S.smy);
    gl.uniform4f(U.uCh,CHOICE.albedo,CHOICE.water,CHOICE.canopy,CHOICE.agree);
    gl.drawArrays(gl.TRIANGLES,0,3);
  }
  return {init:init,resize:resize,draw:draw,ready:function(){return ok;},setQuality:setQuality};
})();

/* CSS fallback if WebGL is unavailable */
function glFallback(){
  var e=$('#env');
  e.style.background='linear-gradient(180deg,#B9D4E8 0%,#7FA8C9 34%,#17466B 68%,#04101B 100%)';
}
window.__ICE={S:S,CHOICE:CHOICE,GL:GL,clamp:clamp,lerp:lerp,smoo:smoo,$:$,$$:$$,DPR:DPR,RM:RM,glFallback:glFallback};
})();
</script>
<script>
/* ============================================================
   2 · SNOW · MAMMOTHS · SCROLL DRIVER
   ============================================================ */
(function(){
'use strict';
var K=window.__ICE, S=K.S, $=K.$, $$=K.$$, clamp=K.clamp, lerp=K.lerp, smoo=K.smoo, RM=K.RM;

/* ---------- SNOW ---------- */
var Snow=(function(){
  var cv=$('#snow'), x=cv.getContext('2d'), W=0,H=0,d=1, P=[], N=0;
  function build(){
    d=K.DPR(1.75); W=cv.clientWidth; H=cv.clientHeight;
    cv.width=Math.round(W*d); cv.height=Math.round(H*d);
    x.setTransform(d,0,0,d,0,0);
    N=RM?0:Math.round(clamp(W*H/5200,90,340));
    P=[];
    for(var i=0;i<N;i++) P.push(mk(true));
  }
  function mk(rand){
    var z=Math.pow(Math.random(),1.7);           /* 0 far .. 1 near */
    return { x:Math.random()*W, y:rand?Math.random()*H:-14-Math.random()*60,
      z:z, r:0.5+z*2.6, sp:0.16+z*0.85, ph:Math.random()*6.28, am:6+z*22, o:0.16+z*0.62 };
  }
  function frame(dt,fade){
    x.clearRect(0,0,W,H);
    if(!N||fade<=0.01) return;
    var wind=S.svel*0.09;
    x.globalAlpha=1;
    for(var i=0;i<N;i++){
      var p=P[i];
      p.y+=p.sp*dt*0.055 + Math.abs(S.svel)*p.z*0.020*dt*0.06;
      p.ph+=0.0009*dt;
      var dx=Math.sin(p.ph)*p.am*0.06 + wind*p.z*0.6;
      /* cursor push */
      var mx=(S.smx*0.5+0.5)*W, my=(0.5-S.smy*0.5)*H;
      var ddx=p.x+dx-mx, ddy=p.y-my, dd=ddx*ddx+ddy*ddy;
      if(dd<16000){ var f=(1-dd/16000)*10*p.z; dx+=ddx/Math.max(8,Math.sqrt(dd))*f; }
      var px=p.x+dx;
      if(p.y>H+16||px<-40||px>W+40){ P[i]=mk(false); continue; }
      x.globalAlpha=p.o*fade;
      x.fillStyle= p.z>0.55 ? 'rgba(255,255,255,1)' : 'rgba(226,240,250,1)';
      x.beginPath(); x.arc(px,p.y,p.r,0,6.2832); x.fill();
    }
    x.globalAlpha=1;
  }
  return {build:build,frame:frame};
})();

/* ---------- THE MONUMENT ----------
   One sculpture, cropped by the frame, parallaxed with scroll and cursor and
   dissolved as the camera enters the ice. */
var Mam=(function(){
  var wrap=$('#mamWrap'), img=$('#mamImg'), ready=false;
  if(img && window.__MAMMOTH){
    img.addEventListener('load',function(){ ready=true; });
    img.src=window.__MAMMOTH;
  }
  function frame(t,fade){
    if(!wrap) return;
    if(fade<=0.004){ wrap.style.opacity='0'; return; }
    var drift = RM?0:Math.sin(t*0.00038)*6;
    var breath= RM?0:Math.sin(t*0.00085)*0.004;
    var parX  = S.smx*-22, parY = S.smy*12;
    var enter = (1-fade)*90;          /* sinks away as we descend into the ice */
    var sc    = 1+breath+(1-fade)*0.06;
    wrap.style.opacity=String(fade);
    wrap.style.transform='translate3d('+(drift+parX).toFixed(1)+'px,'+
      (enter+parY).toFixed(1)+'px,0) scale('+sc.toFixed(4)+')';
  }
  return {frame:frame, layout:function(){}, ready:function(){return ready;}};
})();

/* ---------- SCROLL DRIVER ---------- */
var envEnd=1, beatsEl, whiteEl, closeEl, planetEl, beats=[], cue=$('#cue'), vig=$('#vig'), rail=$('#rail');
var lastPP=-1, proofDone=false;
var railLinks=$$('#rail a'), railTargets=[];

function measure(){
  beatsEl=$('.act--beats'); whiteEl=$('.act--white'); closeEl=$('#closing'); planetEl=$('#planet');
  var vh=window.innerHeight;
  envEnd=Math.max(1,(whiteEl.offsetTop+whiteEl.offsetHeight)-vh);
  railTargets=railLinks.map(function(a){
    var id=a.getAttribute('href').slice(1); var el=document.getElementById(id); return el||document.body;
  });
  Snow.build(); Mam.layout(); K.GL.resize();
}

function updateScroll(){
  var vh=window.innerHeight;
  S.y=window.scrollY||window.pageYOffset||0;
  S.j=clamp(S.y/envEnd,0,1);

  /* beat progress */
  var bp=0;
  if(beatsEl){
    var span=Math.max(1,beatsEl.offsetHeight-vh);
    bp=clamp((S.y-beatsEl.offsetTop)/span,0,1);
  }
  var idx=clamp(Math.floor(bp*4.0),0,3);
  if(S.y<beatsEl.offsetTop-vh*0.4) idx=-1;
  for(var i=0;i<beats.length;i++) beats[i].classList.toggle('on', RM || i===idx);

  var fireRaw = S.y>beatsEl.offsetTop+beatsEl.offsetHeight-vh ? 1 : smoo(0.70,0.93,bp);
  S.fire = fireRaw*(1-smoo(0.56,0.82,S.j));

  /* Pinned chapters: a stage is fully present while it is stuck (rect.top === 0)
     and fades as it approaches or leaves, so two chapters never sit on screen
     together and no stretch of scroll is left empty. */
  function stageState(sel){
    var st=document.querySelector(sel+' .stage');
    if(!st) return null;
    var r=st.getBoundingClientRect();
    var off=Math.abs(r.top);
    return { o:1-clamp(off/(vh*0.52),0,1), drift:-r.top/vh };
  }
  if(!RM){
    var bs=stageState('.act--body'), bi=document.querySelector('.body-in');
    if(bs&&bi){ bi.style.opacity=String(bs.o);
      bi.style.transform='translate3d(0,'+(bs.drift*-40).toFixed(1)+'px,0)'; }

    var ms=stageState('.act--made'), mg=document.querySelector('.made-grid');
    if(ms&&mg){
      mg.style.opacity=String(ms.o);
      var madeEl=document.querySelector('.act--made');
      var mSpan=Math.max(1,madeEl.offsetHeight-vh);
      var mp=clamp((S.y-madeEl.offsetTop)/mSpan,0,1);
      var pl=document.querySelectorAll('.act--made .plate');
      var rates=[-150,90,-58];
      for(var q=0;q<pl.length;q++){
        pl[q].style.transform='translate3d(0,'+((mp-0.5)*rates[q]+ms.drift*-26).toFixed(1)+
          'px,0) scale('+(1+(mp-0.5)*0.05*(q===1?-1:1)).toFixed(4)+')';
      }
      var mh=document.querySelector('.made-head');
      if(mh) mh.style.transform='translate3d(0,'+((mp-0.5)*-92+ms.drift*-40).toFixed(1)+'px,0)';
    }

    var ts=stageState('.act--threshold'), ti=document.querySelector('.threshold');
    if(ts&&ti){ ti.style.opacity=String(ts.o);
      ti.style.transform='translate3d(0,'+(ts.drift*-34).toFixed(1)+'px,0)'; }

    var hi=document.querySelector('.hero-in');
    var hs=document.querySelector('.hero-scrim');
    var hp=clamp(S.y/(vh*1.05),0,1);
    if(hi){
      hi.style.transform='translate3d(0,'+(-hp*80).toFixed(1)+'px,0)';
      hi.style.opacity=String(clamp(1-hp*1.3,0,1));
    }
    if(hs) hs.style.opacity=String(clamp(1-hp*1.15,0,1));
  }

  /* threshold copy inverts as the whiteout floods through it */
  var th=document.querySelector('.act--threshold');
  if(th) th.classList.toggle('inv', S.j>0.925);

  /* closing planet mode */
  var m=0;
  if(closeEl){
    var start=closeEl.offsetTop-vh*1.75;
    m=clamp((S.y-start)/(vh*0.85),0,1);
  }
  S.mode=m;

  /* env visibility for render throttling */
  S.envVisible = (S.y < envEnd+vh*1.4) || m>0.002;

  /* hud */
  if(cue) cue.style.opacity = String(clamp(1-S.y/(vh*0.5),0,1));
  if(vig) vig.style.opacity = String(clamp(1-smoo(0.88,0.99,S.j)*(1-m),0,1));
  if(rail) rail.classList.toggle('show', S.y>envEnd*0.985);

  /* PROOF: the ozone hole opens and closes against a running year while the
     copy arrives beat by beat */
  var proofEl2=document.getElementById('proof');
  if(proofEl2 && window.__ICE.earth){
    var pin=document.getElementById('proofPin');
    var pinTop=pin.getBoundingClientRect().top+S.y;
    var pSpan=Math.max(1, pin.offsetHeight - vh);
    var pp=clamp((S.y-pinTop)/pSpan,0,1);
    if(RM) pp=1;
    if(!proofDone || Math.abs(pp-lastPP)>0.0012){
      lastPP=pp;
      var t=clamp((pp-0.10)/0.74,0,1);
      var yr=1987+t*(2066-1987);
      var st=window.__ICE.earth.set(yr);
      var yEl=document.getElementById('earthYear');
      if(yEl) yEl.textContent=String(st.year);
      var nEl=document.getElementById('earthNote');
      if(nEl){
        var note = st.year<1992 ? 'Montreal Protocol signed'
          : st.year<2004 ? 'Peak — 29.9 million km\u00B2 measured in 2000'
          : st.year<2019 ? 'Phase-out under way · CFC-11 breach detected 2018'
          : st.year<2060 ? 'Closing'
          : 'Projected return to 1980 values';
        if(nEl.textContent!==note) nEl.textContent=note;
      }
      var wrap=proofEl2.querySelector('.earth-wrap');
      if(wrap && !RM) wrap.style.transform='scale('+(0.78+0.22*clamp(pp/0.22,0,1)).toFixed(3)+')';
      /* beats */
      proofEl2.querySelectorAll('[data-pb]').forEach(function(e){
        var bi=+e.getAttribute('data-pb');
        var start=({0:0,1:0.09,2:0.32,3:0.76})[bi];
        if(bi===2){
          var sibs=Array.prototype.slice.call(e.parentNode.children);
          start=0.32+sibs.indexOf(e)*0.10;
        }
        e.classList.toggle('pb-in', RM || pp>=start);
      });
      proofDone = pp>=1;
    }
  }

  /* the five interventions arrive as a deck: each card slides over the one before */
  var deck=document.getElementById('ivDeck');
  if(deck && !RM && window.innerWidth>1000){
    var cards=deck.children, topPx=Math.max(46,Math.min(84,vh*0.07));
    for(var c=0;c<cards.length;c++){
      var card=cards[c], own=card.getBoundingClientRect();
      /* rise: the card travelling up into place */
      var rise=clamp((vh-own.top)/(vh*0.55),0,1);
      var re=rise*rise*(3-2*rise);
      /* cover: how far the next card has slid over this one */
      var cov=0;
      if(c+1<cards.length){
        var nx=cards[c+1].getBoundingClientRect();
        cov=clamp(1-(nx.top-topPx)/Math.max(1,vh-topPx),0,1);
        cov=cov*cov*(3-2*cov);
      }
      /* opacity settles well before the card overlaps the one beneath it, so a
         rising card never ghosts; recession is carried by scale, blur and value */
      var fade=clamp((vh*1.02-own.top)/(vh*0.30),0,1);
      var sc=(0.965+0.035*re)*(1-0.06*cov);
      var ty=(1-re)*36 - cov*18;
      card.style.transform='translate3d(0,'+ty.toFixed(1)+'px,0) scale('+sc.toFixed(4)+')';
      card.style.opacity=fade.toFixed(3);
      card.style.filter= cov>0.02
        ? 'blur('+(2.8*cov).toFixed(2)+'px) brightness('+(1-0.09*cov).toFixed(3)+')'
        : 'none';
      card.style.pointerEvents = cov>0.35 ? 'none' : 'auto';
      var st=card.querySelector('.iv-step i');
      if(st) st.style.width=Math.round(clamp(re-cov,0,1)*100)+'%';
    }
  }

  /* HUD adapts to whatever chapter is under it */
  var hud=document.getElementById('hud');
  if(hud){
    var proofEl=document.getElementById('proof');
    var lit = proofEl && planetEl && (S.y+80)>proofEl.offsetTop && (S.y+80)<planetEl.offsetTop;
    hud.classList.toggle('lit-mode', !!lit);
    hud.classList.toggle('past-open', S.y>envEnd*0.9);
  }

  /* rail current */
  var cur=0;
  for(var r=0;r<railTargets.length;r++){
    if(railTargets[r].offsetTop<=S.y+vh*0.42) cur=r;
  }
  for(var r2=0;r2<railLinks.length;r2++) railLinks[r2].setAttribute('aria-current', r2===cur?'true':'false');

  checkReveals();
}

/* ---------- reveal (rect-driven: deterministic inside sticky stages) ---------- */
var rvQ=[];
function reveals(){
  rvQ=$$('[data-rv]');
  rvQ.forEach(function(e,i){ e.style.transitionDelay=(Math.min(i%4,3)*70)+'ms'; });
  checkReveals();
}
function checkReveals(){
  if(!rvQ.length) return;
  var vh=window.innerHeight, keep=[];
  for(var i=0;i<rvQ.length;i++){
    var e=rvQ[i], r=e.getBoundingClientRect();
    if(r.top<vh*0.90 && r.bottom>vh*0.02){
      e.classList.add('in');
      if(e.getAttribute('data-rv')==='mask'){
        setTimeout((function(el){ return function(){ el.style.clipPath='none'; }; })(e),1400);
      }
    }
    else keep.push(e);
  }
  rvQ=keep;
}

/* ---------- pointer ---------- */
function pointer(){
  var move=function(cx,cy){
    S.mx=(cx/window.innerWidth)*2-1;
    S.my=1-(cy/window.innerHeight)*2;
  };
  window.addEventListener('mousemove',function(e){move(e.clientX,e.clientY);},{passive:true});
  window.addEventListener('touchmove',function(e){ if(e.touches[0]) move(e.touches[0].clientX,e.touches[0].clientY); },{passive:true});
}

/* ---------- main loop ---------- */
var last=performance.now(), prevY=0, acc=0;
var frameAcc=0, frameN=0, qLevel=1.0;
function tick(now){
  var dt=Math.min(48,now-last); last=now;
  /* adaptive resolution: if frames get expensive, render the environment smaller */
  if(!RM && S.envVisible){
    frameAcc+=dt; frameN++;
    if(frameN>=45){
      var avg=frameAcc/frameN; frameAcc=0; frameN=0;
      if(avg>30 && qLevel>0.55) qLevel-=0.18;
      else if(avg<19 && qLevel<1.0) qLevel+=0.12;
      qLevel=clamp(qLevel,0.55,1.0);
      K.GL.setQuality&&K.GL.setQuality(qLevel);
    }
  }
  S.t=now*0.001;
  var y=window.scrollY||window.pageYOffset||0;
  S.vel=(y-prevY); prevY=y;
  S.svel=lerp(S.svel,clamp(S.vel,-90,90),0.14);
  S.sj=lerp(S.sj,S.j,RM?1:0.11);
  S.smx=lerp(S.smx,S.mx,0.055); S.smy=lerp(S.smy,S.my,0.055);

  if(S.envVisible){
    if(K.GL.ready()) K.GL.draw();
    var snowFade=clamp(1-smoo(0.26,0.46,S.sj),0,1)*(1-S.mode);
    var faunaFade=clamp(1-smoo(0.10,0.22,S.sj),0,1)*(1-S.mode);
    Snow.frame(dt,snowFade);
    Mam.frame(now,faunaFade);
  }
  requestAnimationFrame(tick);
}

/* ---------- boot ---------- */
function boot(){
  beats=$$('#beats .beat');
  if(!window.__ICE.GL.init()) K.glFallback();
  measure(); updateScroll(); reveals(); pointer();
  window.addEventListener('scroll',updateScroll,{passive:true});
  var rt; window.addEventListener('resize',function(){ clearTimeout(rt); rt=setTimeout(function(){ measure(); updateScroll(); },160); },{passive:true});
  window.addEventListener('orientationchange',function(){ setTimeout(function(){measure();updateScroll();},300); });
  requestAnimationFrame(tick);
}
window.__ICE.boot=boot;
window.__ICE.measure=measure;
})();
</script>
<script>
/* ============================================================
   3 · GENERATED PLATES  (documentary imagery, procedural)
   ============================================================ */
(function(){
'use strict';
var K=window.__ICE, $=K.$, $$=K.$$, clamp=K.clamp;

function rnd(s){ var t=s; return function(){ t=(t*16807)%2147483647; return (t-1)/2147483646; }; }
function blob(x,cx,cy,rx,ry,pts,rough,R){
  x.beginPath();
  var P=[];
  for(var i=0;i<pts;i++){
    var a=i/pts*6.2832;
    var k=1+ (Math.sin(a*3+R()*0.4)*0.5+ (R()-0.5))*rough;
    P.push([cx+Math.cos(a)*rx*k, cy+Math.sin(a)*ry*k]);
  }
  x.moveTo((P[0][0]+P[pts-1][0])/2,(P[0][1]+P[pts-1][1])/2);
  for(var j=0;j<pts;j++){
    var c=P[j], n=P[(j+1)%pts];
    x.quadraticCurveTo(c[0],c[1],(c[0]+n[0])/2,(c[1]+n[1])/2);
  }
  x.closePath();
}
function grain(x,w,h,amt,R){
  var img=x.getImageData(0,0,w,h), p=img.data;
  for(var i=0;i<p.length;i+=4){
    var n=(R()-0.5)*amt;
    p[i]=clamp(p[i]+n,0,255); p[i+1]=clamp(p[i+1]+n,0,255); p[i+2]=clamp(p[i+2]+n,0,255);
  }
  x.putImageData(img,0,0);
}
function rock(x,w,h,R,c1,c2){
  var g=x.createLinearGradient(0,0,w*0.6,h);
  g.addColorStop(0,c1); g.addColorStop(1,c2);
  x.fillStyle=g; x.fillRect(0,0,w,h);
  for(var i=0;i<160;i++){
    var cx=R()*w, cy=R()*h, r=5+R()*52;
    x.globalAlpha=0.030+R()*0.042;
    x.fillStyle= R()>0.5?'#000':'#fff';
    x.beginPath(); x.ellipse(cx,cy,r,r*(0.4+R()*0.8),R()*3.14,0,6.2832); x.fill();
  }
  x.globalAlpha=1;
}

function drawFlute(x,w,h,R){
  rock(x,w,h,R,'#1B2C3A','#070F18');
  /* the bone */
  x.save(); x.translate(w*0.5,h*0.5); x.rotate(-0.42);
  var L=h*0.72, r0=w*0.062, r1=w*0.044;
  var g=x.createLinearGradient(-r0,0,r0,0);
  g.addColorStop(0,'#5E6B70'); g.addColorStop(0.32,'#D9D3C4'); g.addColorStop(0.62,'#EFE9DC'); g.addColorStop(1,'#8A8578');
  x.fillStyle=g;
  x.beginPath();
  x.moveTo(-r0,-L/2); x.quadraticCurveTo(-r0*1.5,0,-r1,L/2);
  x.lineTo(r1,L/2); x.quadraticCurveTo(r0*1.35,0,r0,-L/2);
  x.closePath(); x.fill();
  /* condyle ends */
  x.fillStyle='#E7E1D3';
  x.beginPath(); x.ellipse(0,-L/2,r0*1.32,r0*0.72,0,0,6.2832); x.fill();
  x.beginPath(); x.ellipse(0,L/2,r1*1.22,r1*0.66,0,0,6.2832); x.fill();
  /* finger holes */
  for(var i=0;i<5;i++){
    var y=-L*0.24+i*L*0.115, rr=w*0.019;
    x.fillStyle='#0C1218';
    x.beginPath(); x.ellipse(w*0.004,y,rr,rr*1.15,0,0,6.2832); x.fill();
    x.strokeStyle='rgba(255,255,255,.28)'; x.lineWidth=1;
    x.beginPath(); x.ellipse(w*0.004,y,rr*1.25,rr*1.42,0,0,6.2832); x.stroke();
  }
  /* hairline cracks */
  x.strokeStyle='rgba(40,34,26,.42)'; x.lineWidth=0.9;
  for(var c=0;c<7;c++){
    x.beginPath(); var sy=-L/2+R()*L;
    x.moveTo(-r0*0.7+R()*r0,sy);
    x.lineTo(-r0*0.7+R()*r0*1.6, sy+ (R()-0.5)*L*0.16);
    x.stroke();
  }
  x.restore();
  /* raking light */
  var lg=x.createRadialGradient(w*0.28,h*0.2,10,w*0.4,h*0.4,h*0.9);
  lg.addColorStop(0,'rgba(196,222,240,.24)'); lg.addColorStop(1,'rgba(0,0,0,0)');
  x.fillStyle=lg; x.fillRect(0,0,w,h);
  grain(x,w,h,26,R);
}

function hand(c,cx,cy,s,rot){
  c.save(); c.translate(cx,cy); c.rotate(rot); c.scale(s,s);
  c.lineCap='round'; c.lineJoin='round';
  /* palm */
  c.beginPath(); c.ellipse(0,16,25,30,0,0,6.2832); c.fill();
  /* fingers + thumb: x0,y0,x1,y1,halfwidth */
  var fing=[[-20,-10,-27,-44,8],[-7,-20,-10,-58,8.5],[7,-21,12,-56,8.5],[19,-14,29,-40,8],[-27,10,-50,-2,8.5]];
  for(var i=0;i<fing.length;i++){
    var f=fing[i];
    c.lineWidth=f[4]*2;
    c.beginPath(); c.moveTo(f[0],f[1]); c.lineTo(f[2],f[3]); c.stroke();
  }
  /* wrist */
  c.lineWidth=26; c.beginPath(); c.moveTo(0,34); c.lineTo(2,54); c.stroke();
  c.restore();
}
function drawHands(x,w,h,R){
  /* pale limestone wall — the stencils must read as dark hands on ochre */
  rock(x,w,h,R,'#CFC2AE','#7C6D5C');
  var hs=[[w*0.36,h*0.33,2.05,-0.14],[w*0.63,h*0.62,1.72,0.26]];
  var off=document.createElement('canvas'); off.width=w; off.height=h;
  var o=off.getContext('2d');
  /* ochre blown around each hand: dense field, soft edge, speckle on top */
  for(var k=0;k<hs.length;k++){
    var cx=hs[k][0], cy=hs[k][1], rad=hs[k][2]*82;
    var rg=o.createRadialGradient(cx,cy,rad*0.10,cx,cy,rad);
    rg.addColorStop(0,'rgba(129,38,14,.94)');
    rg.addColorStop(0.52,'rgba(142,46,18,.80)');
    rg.addColorStop(0.82,'rgba(150,58,24,.34)');
    rg.addColorStop(1,'rgba(150,58,24,0)');
    o.fillStyle=rg; o.beginPath(); o.arc(cx,cy,rad,0,6.2832); o.fill();
    for(var i=0;i<2200;i++){
      var a=R()*6.2832, d=Math.pow(R(),0.5)*rad;
      var sx=cx+Math.cos(a)*d, sy=cy+Math.sin(a)*d*1.05;
      var t=R();
      o.fillStyle= t>0.66?'#4E1605': (t>0.33?'#7C2409':'#C06A2E');
      o.globalAlpha=(0.14+R()*0.40)*(1-d/rad*0.6);
      o.beginPath(); o.arc(sx,sy,0.5+R()*3.0,0,6.2832); o.fill();
    }
    o.globalAlpha=1;
  }
  o.globalCompositeOperation='destination-out';
  o.fillStyle='#000'; o.strokeStyle='#000';
  for(var k2=0;k2<hs.length;k2++) hand(o,hs[k2][0],hs[k2][1],hs[k2][2],hs[k2][3]);
  o.globalCompositeOperation='source-over';
  x.drawImage(off,0,0);
  /* raking firelight from below-left */
  var lg=x.createRadialGradient(w*0.30,h*0.82,10,w*0.45,h*0.6,h*1.0);
  lg.addColorStop(0,'rgba(255,168,80,.22)'); lg.addColorStop(0.45,'rgba(70,38,16,.14)');
  lg.addColorStop(1,'rgba(10,6,3,.66)');
  x.fillStyle=lg; x.fillRect(0,0,w,h);
  grain(x,w,h,32,R);
}

function drawHearth(x,w,h,R){
  rock(x,w,h,R,'#12202C','#050B12');
  var cx=w*0.5, cy=h*0.60;
  /* ember bed */
  var eg=x.createRadialGradient(cx,cy,2,cx,cy,w*0.42);
  eg.addColorStop(0,'rgba(255,232,180,.98)'); eg.addColorStop(0.18,'rgba(255,150,50,.92)');
  eg.addColorStop(0.45,'rgba(190,62,16,.55)'); eg.addColorStop(1,'rgba(0,0,0,0)');
  x.fillStyle=eg; x.beginPath(); x.ellipse(cx,cy,w*0.40,w*0.27,0,0,6.2832); x.fill();
  /* stones */
  for(var i=0;i<11;i++){
    var a=i/11*6.2832+0.2, rx=w*0.30, ry=w*0.20;
    var sx=cx+Math.cos(a)*rx, sy=cy+Math.sin(a)*ry;
    var s=w*0.05*(0.7+R()*0.7);
    x.save(); x.translate(sx,sy); x.rotate(R()*3.14);
    var lit=Math.max(0,-Math.sin(a));
    x.fillStyle='rgb('+(38+lit*120)+','+(40+lit*70)+','+(46+lit*40)+')';
    x.beginPath();
    for(var p=0;p<8;p++){ var aa=p/8*6.2832, k=1+(R()-0.5)*0.35;
      var px=Math.cos(aa)*s*k, py=Math.sin(aa)*s*0.72*k;
      p===0?x.moveTo(px,py):x.lineTo(px,py); }
    x.closePath(); x.fill();
    x.restore();
  }
  /* flame tongues — thin, uneven, additive */
  x.globalCompositeOperation='lighter';
  for(var f=0;f<26;f++){
    var fx=cx+(R()-0.5)*w*0.34, fh=w*(0.06+Math.pow(R(),1.7)*0.34), bw=w*(0.006+R()*0.020);
    var lean=(R()-0.5)*w*0.10;
    var fg=x.createLinearGradient(fx,cy+w*0.02,fx,cy-fh);
    fg.addColorStop(0,'rgba(255,214,140,.42)');
    fg.addColorStop(0.35,'rgba(255,140,50,.26)');
    fg.addColorStop(1,'rgba(255,90,30,0)');
    x.fillStyle=fg;
    x.beginPath(); x.moveTo(fx-bw,cy+w*0.02);
    x.quadraticCurveTo(fx-bw*0.5+lean*0.6,cy-fh*0.55,fx+lean,cy-fh);
    x.quadraticCurveTo(fx+bw*0.5+lean*0.6,cy-fh*0.5,fx+bw,cy+w*0.02);
    x.closePath(); x.fill();
  }
  /* hot core */
  var cg=x.createRadialGradient(cx,cy+w*0.01,1,cx,cy,w*0.16);
  cg.addColorStop(0,'rgba(255,246,214,.85)'); cg.addColorStop(0.4,'rgba(255,168,64,.45)');
  cg.addColorStop(1,'rgba(255,120,40,0)');
  x.fillStyle=cg; x.beginPath(); x.arc(cx,cy,w*0.16,0,6.2832); x.fill();
  x.globalCompositeOperation='source-over';
  /* smoke */
  x.globalAlpha=0.10;
  for(var s2=0;s2<26;s2++){ x.fillStyle='#B9D4E8';
    x.beginPath(); x.arc(cx+(R()-0.5)*w*0.5, cy-w*0.3-R()*h*0.42, 8+R()*40,0,6.2832); x.fill(); }
  x.globalAlpha=1;
  var vg=x.createRadialGradient(cx,cy,w*0.1,cx,cy,h*0.75);
  vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1,'rgba(2,6,10,.82)');
  x.fillStyle=vg; x.fillRect(0,0,w,h);
  grain(x,w,h,24,R);
}

var MASKS={
  flute:{rx:0.33,ry:0.49,pts:14,rough:0.22,cx:0.50,cy:0.50},
  hands:{rx:0.48,ry:0.38,pts:9, rough:0.30,cx:0.50,cy:0.50},
  hearth:{rx:0.46,ry:0.44,pts:7, rough:0.34,cx:0.50,cy:0.52}
};
function makePlate(cv){
  var kind=cv.getAttribute('data-plate'), w=cv.width, h=cv.height;
  var x=cv.getContext('2d'), R=rnd(kind==='flute'?9137:kind==='hands'?4421:7703);
  var m=MASKS[kind];
  x.clearRect(0,0,w,h);
  x.save();
  blob(x,w*m.cx,h*m.cy,w*m.rx,h*m.ry,m.pts,m.rough,rnd(kind.length*991));
  x.clip();
  if(kind==='flute') drawFlute(x,w,h,R);
  else if(kind==='hands') drawHands(x,w,h,R);
  else drawHearth(x,w,h,R);
  x.restore();
  /* soft inner edge */
  x.save();
  blob(x,w*m.cx,h*m.cy,w*m.rx,h*m.ry,m.pts,m.rough,rnd(kind.length*991));
  x.strokeStyle='rgba(185,212,232,.16)'; x.lineWidth=1.5; x.stroke();
  x.restore();
}

/* The Earth, redrawn per frame with the Antarctic ozone hole opening and closing.
   The hole is illustrative: only the two documented anchors are stated as fact —
   the measured 2000 peak and the projected return to 1980 values around 2066. */
var EARTH={cv:null,ctx:null,R:null,land:null,year:-1,hole:0,scale:1,first:true};

function holeArea(year){
  /* 0 = closed, 1 = the measured 2000 maximum */
  if(year<=1980) return 0;
  if(year<2000)  return 0.30+0.70*Math.pow((year-1980)/20,0.85);
  if(year>=2066) return 0;
  var t=(year-2000)/66;
  return 1-Math.pow(t,0.78);
}

function initEarth(){
  var cv=$('#earth'); if(!cv) return;
  EARTH.cv=cv; EARTH.ctx=cv.getContext('2d'); EARTH.R=rnd(2029);
  /* landmasses are generated once so the globe does not shimmer between frames */
  var R2=rnd(4471), land=[];
  for(var i=0;i<16;i++){
    land.push({a:R2()*6.2832,d:Math.pow(R2(),0.6),
      rx:0.07+R2()*0.22, ry:0.05+R2()*0.15, al:0.16+R2()*0.20, seed:R2()*9999});
  }
  EARTH.land=land;
  drawEarth();
}

function drawEarth(){
  var cv=EARTH.cv; if(!cv) return;
  var x=EARTH.ctx, w=cv.width, h=cv.height, R=rnd(2029);
  var cx=w/2, cy=h/2, r=w*0.345;
  x.clearRect(0,0,w,h);

  var hg=x.createRadialGradient(cx,cy,r*0.97,cx,cy,r*1.34);
  hg.addColorStop(0,'rgba(126,172,208,.40)');
  hg.addColorStop(0.35,'rgba(126,172,208,.14)');
  hg.addColorStop(1,'rgba(126,172,208,0)');
  x.fillStyle=hg; x.beginPath(); x.arc(cx,cy,r*1.34,0,6.2832); x.fill();

  x.save(); x.beginPath(); x.arc(cx,cy,r,0,6.2832); x.clip();
  var g=x.createLinearGradient(cx-r*0.7,cy-r*0.8,cx+r*0.8,cy+r);
  g.addColorStop(0,'#9FC0D8'); g.addColorStop(0.42,'#6E96B7'); g.addColorStop(1,'#2E5375');
  x.fillStyle=g; x.fillRect(cx-r,cy-r,r*2,r*2);

  EARTH.land.forEach(function(L){
    var lx=cx+Math.cos(L.a)*L.d*r*0.88, ly=cy+Math.sin(L.a)*L.d*r*0.94;
    x.globalAlpha=L.al; x.fillStyle='#E9F0F4';
    blob(x,lx,ly,r*L.rx,r*L.ry,9,0.52,rnd(L.seed)); x.fill();
  });
  x.globalAlpha=1;

  ['t','b'].forEach(function(k,i){
    var cg=x.createLinearGradient(cx,cy+(i?r:-r),cx,cy+(i?r*0.52:-r*0.52));
    cg.addColorStop(0,'rgba(246,250,252,.92)'); cg.addColorStop(1,'rgba(246,250,252,0)');
    x.fillStyle=cg; x.fillRect(cx-r,i?cy+r*0.45:cy-r,r*2,r*0.6);
  });

  var tg=x.createRadialGradient(cx-r*0.42,cy-r*0.44,r*0.05,cx-r*0.12,cy-r*0.10,r*1.42);
  tg.addColorStop(0,'rgba(255,255,255,.32)');
  tg.addColorStop(0.42,'rgba(255,255,255,0)');
  tg.addColorStop(0.72,'rgba(8,20,32,.24)');
  tg.addColorStop(1,'rgba(6,16,26,.64)');
  x.fillStyle=tg; x.fillRect(cx-r,cy-r,r*2,r*2);

  /* the hole, over the south pole — drawn above the shading so it stays legible */
  var a=EARTH.hole;
  if(a>0.004){
    var k=Math.min(1,a*1.35);
    var hr=r*(0.27+0.44*Math.sqrt(a));
    var hy=cy+r*0.60;
    var og=x.createRadialGradient(cx,hy,hr*0.08,cx,hy,hr);
    og.addColorStop(0,'rgba(96,32,180,'+(0.92*k)+')');
    og.addColorStop(0.40,'rgba(124,58,204,'+(0.72*k)+')');
    og.addColorStop(0.72,'rgba(158,116,222,'+(0.36*k)+')');
    og.addColorStop(1,'rgba(168,140,228,0)');
    x.fillStyle=og;
    x.beginPath(); x.ellipse(cx,hy,hr*1.32,hr*0.62,0,0,6.2832); x.fill();
    x.strokeStyle='rgba(78,22,158,'+(0.40*k)+')'; x.lineWidth=1.5;
    x.beginPath();
    for(var q=0;q<=44;q++){
      var th=q/44*6.2832;
      var wob=1+0.09*Math.sin(th*3.1+1.2)+0.05*Math.sin(th*5.7);
      var px=cx+Math.cos(th)*hr*1.16*wob, py=hy+Math.sin(th)*hr*0.58*wob;
      q===0?x.moveTo(px,py):x.lineTo(px,py);
    }
    x.closePath(); x.stroke();
  }
  var rg=x.createRadialGradient(cx,cy,r*0.90,cx,cy,r);
  rg.addColorStop(0,'rgba(190,222,244,0)'); rg.addColorStop(1,'rgba(214,236,250,.55)');
  x.fillStyle=rg; x.fillRect(cx-r,cy-r,r*2,r*2);
  x.restore();

  x.strokeStyle='rgba(11,22,32,.22)'; x.lineWidth=1.2;
  x.beginPath(); x.arc(cx,cy,r,0,6.2832); x.stroke();
}

window.__ICE.earth={
  set:function(year){
    var y=Math.round(year);
    if(y!==EARTH.year || EARTH.first){
      EARTH.first=false; EARTH.year=y; EARTH.hole=holeArea(y);
      drawEarth();
    }
    return {year:y, hole:EARTH.hole};
  },
  holeArea:holeArea
};

window.__ICE.plates=function(){ $$('canvas[data-plate]').forEach(makePlate); initEarth(); };
})();
</script>
<script>
/* ============================================================
   4 · INTERVENTION LABS
   ============================================================ */
(function(){
'use strict';
var K=window.__ICE, $=K.$, $$=K.$$, clamp=K.clamp, lerp=K.lerp, smoo=K.smoo, RM=K.RM;
var live=[];   /* {el, draw} — ticked only while on screen */

function fit(cv){
  var d=K.DPR(2), w=cv.clientWidth||cv.width, h=Math.round(w*cv.height/cv.width);
  if(!w) return null;
  cv.style.height=h+'px';
  cv.width=Math.round(w*d); cv.height=Math.round(h*d);
  var x=cv.getContext('2d'); x.setTransform(d,0,0,d,0,0);
  return {x:x,w:w,h:h};
}
function reg(cv,draw){
  var st={cv:cv,draw:draw,on:false,g:null};
  st.resize=function(){ st.g=fit(cv); };
  st.resize();
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(e){ st.on=e[0].isIntersecting; },{threshold:0.05}).observe(cv);
  } else st.on=true;
  live.push(st); return st;
}
function loop(t){
  for(var i=0;i<live.length;i++){ var s=live[i]; if(s.on&&s.g) s.draw(s.g.x,s.g.w,s.g.h,t); }
  requestAnimationFrame(loop);
}

/* ---------- 01 · flood & freeze ---------- */
(function(){
  var cv=$('#labIce'); if(!cv) return;
  var N=110, add=new Float32Array(N), tgt=new Float32Array(N);
  var read=$('#iceRead'), pressing=false, px=-1;
  function paint(cx,w){
    var i=Math.round(cx/w*(N-1));
    for(var k=-9;k<=9;k++){
      var j=i+k; if(j<0||j>=N-0) continue;
      tgt[j]=Math.min(1, tgt[j]+0.16*Math.exp(-k*k/30));
    }
  }
  function pos(e){ var r=cv.getBoundingClientRect();
    var c=e.touches&&e.touches[0]?e.touches[0]:e; return {x:c.clientX-r.left,y:c.clientY-r.top,w:r.width}; }
  cv.addEventListener('pointerdown',function(e){ pressing=true; cv.setPointerCapture&&cv.setPointerCapture(e.pointerId);
    var p=pos(e); px=p.x; paint(p.x,p.w); e.preventDefault(); });
  cv.addEventListener('pointermove',function(e){ var p=pos(e); px=p.x; if(pressing){ paint(p.x,p.w); e.preventDefault(); } });
  window.addEventListener('pointerup',function(){ pressing=false; });
  cv.addEventListener('pointerleave',function(){ if(document.activeElement!==cv) px=-1; });
  /* keyboard equivalent */
  var kx=0.5;
  cv.addEventListener('focus',function(){ px=cv.clientWidth*kx; });
  cv.addEventListener('blur',function(){ px=-1; pressing=false; });
  cv.addEventListener('keydown',function(e){
    var w=cv.clientWidth||760, step=0.045;
    if(e.key==='ArrowLeft'){ kx=Math.max(0,kx-step); px=w*kx; e.preventDefault(); }
    else if(e.key==='ArrowRight'){ kx=Math.min(1,kx+step); px=w*kx; e.preventDefault(); }
    else if(e.key==='ArrowUp'||e.key===' '||e.key==='Enter'){
      px=w*kx; for(var n=0;n<6;n++) paint(px,w); pressing=true;
      setTimeout(function(){ pressing=false; },220); e.preventDefault();
    } else return;
  });
  $$('[data-reset="ice"]').forEach(function(b){ b.addEventListener('click',function(){
    for(var i=0;i<N;i++) tgt[i]=0; }); });

  reg(cv,function(x,w,h,t){
    var sum=0;
    for(var i=0;i<N;i++){ add[i]=lerp(add[i],tgt[i],0.10); sum+=add[i]; }
    read.textContent=Math.round(sum/N*62);

    var horizon=h*0.26, top=h*0.40, base=h*0.50;
    /* polar sky */
    var g=x.createLinearGradient(0,0,0,horizon);
    g.addColorStop(0,'#04101C'); g.addColorStop(1,'#173C5C');
    x.fillStyle=g; x.fillRect(0,0,w,horizon);
    /* low sun */
    var sg=x.createRadialGradient(w*0.74,horizon,2,w*0.74,horizon,h*0.34);
    sg.addColorStop(0,'rgba(226,238,248,.50)'); sg.addColorStop(1,'rgba(226,238,248,0)');
    x.fillStyle=sg; x.fillRect(0,0,w,horizon+2);
    /* pressure ridges on the horizon */
    x.fillStyle='#0B2338';
    x.beginPath(); x.moveTo(0,horizon+3);
    for(var fx=0;fx<=w;fx+=7) x.lineTo(fx,horizon-1-Math.abs(Math.sin(fx*0.019)+0.4*Math.sin(fx*0.061))*9);
    x.lineTo(w,horizon+3); x.closePath(); x.fill();
    /* open water between the horizon and the slab */
    var wg=x.createLinearGradient(0,horizon,0,top);
    wg.addColorStop(0,'#0A2237'); wg.addColorStop(1,'#051726');
    x.fillStyle=wg; x.fillRect(0,horizon,w,top-horizon);
    /* deep water */
    var dg=x.createLinearGradient(0,base,0,h);
    dg.addColorStop(0,'#062033'); dg.addColorStop(1,'#01080F');
    x.fillStyle=dg; x.fillRect(0,base,w,h-base);

    var ORIG=base+h*0.11;
    function topY(i){ return top - add[i]*h*0.045; }
    function botY(i){ return ORIG + add[i]*h*0.30; }

    /* the ice that was already there */
    var og=x.createLinearGradient(0,top,0,ORIG);
    og.addColorStop(0,'#C9DFEE'); og.addColorStop(1,'#7BA6C6');
    x.fillStyle=og; x.fillRect(0,top,w,ORIG-top);
    /* the ice grown underneath */
    x.beginPath();
    x.moveTo(0,ORIG);
    for(var i3=0;i3<N;i3++){ var xx3=i3/(N-1)*w; x.lineTo(xx3, botY(i3)); }
    x.lineTo(w,ORIG); x.closePath();
    var ng=x.createLinearGradient(0,ORIG,0,ORIG+h*0.30);
    ng.addColorStop(0,'#EDF6FC'); ng.addColorStop(0.45,'#A9CFE8'); ng.addColorStop(1,'#38749F');
    x.fillStyle=ng; x.fill();
    /* snow that piles on top */
    x.beginPath(); x.moveTo(0,top);
    for(var i2=0;i2<N;i2++){ var xx=i2/(N-1)*w; x.lineTo(xx,topY(i2)); }
    x.lineTo(w,top); x.closePath();
    x.fillStyle='#F4F9FC'; x.fill();
    /* surface line + crust */
    x.strokeStyle='rgba(255,255,255,.85)'; x.lineWidth=1.4;
    x.beginPath();
    for(var i5=0;i5<N;i5++){ var xx5=i5/(N-1)*w; i5===0?x.moveTo(xx5,topY(i5)):x.lineTo(xx5,topY(i5)); }
    x.stroke();
    /* the original underside, dashed */
    x.setLineDash([5,5]); x.strokeStyle='rgba(255,255,255,.55)'; x.lineWidth=1;
    x.beginPath(); x.moveTo(0,ORIG); x.lineTo(w,ORIG); x.stroke();
    x.setLineDash([]);
    /* trapped bubbles in the new ice */
    for(var bq=0;bq<120;bq++){
      var bi=(bq*17)%N, bx=bi/(N-1)*w;
      if(add[bi]<0.08) continue;
      var by=ORIG+((bq*29)%100)/100*(botY(bi)-ORIG);
      x.fillStyle='rgba(255,255,255,.4)';
      x.beginPath(); x.arc(bx,by,0.8+((bq*7)%3)*0.4,0,6.2832); x.fill();
    }
    /* pump rig */
    if(px>=0){
      var pi=clamp(Math.round(px/w*(N-1)),0,N-1), py=topY(pi);
      x.strokeStyle='rgba(255,255,255,.5)'; x.lineWidth=1.2;
      x.beginPath(); x.moveTo(px,py-h*0.13); x.lineTo(px,botY(pi)+8); x.stroke();
      x.fillStyle='rgba(255,255,255,.94)';
      x.fillRect(px-9,py-h*0.155,18,h*0.032);
      if(pressing){
        x.globalAlpha=0.6; x.fillStyle='#DCEFFA';
        for(var d2=0;d2<10;d2++){
          x.beginPath();
          x.arc(px+(Math.random()-0.5)*24, py-4-Math.random()*30, 1+Math.random()*2.4,0,6.2832);
          x.fill();
        }
        x.globalAlpha=1;
      }
    }
    x.fillStyle='rgba(199,222,238,.55)'; x.font='10px "Space Grotesk",monospace';
    x.fillText('ORIGINAL UNDERSIDE',12,ORIG-7);
    x.fillStyle='rgba(199,222,238,.42)'; x.font='10px "Space Grotesk",monospace';
    x.fillText('SEA ICE \u2014 CROSS SECTION',12,18);
    x.fillText('SEAWATER',12,h-12);
  });
})();

/* ---------- 02 · roofs ---------- */
(function(){
  var grid=$('#roofs'); if(!grid) return;
  var COLS=window.matchMedia('(max-width:640px)').matches?8:10, ROWS=4, n=COLS*ROWS;
  var read=$('#roofRead'), pct=$('#roofPct'), cells=[];
  for(var i=0;i<n;i++){
    var b=document.createElement('button');
    b.type='button'; b.setAttribute('aria-pressed','false');
    b.setAttribute('aria-label','Roof '+(i+1)+' of '+n);
    grid.appendChild(b); cells.push(b);
  }
  function upd(){
    var on=cells.filter(function(c){return c.getAttribute('aria-pressed')==='true';}).length;
    var f=on/n;
    read.textContent=(41.0-f*4.0).toFixed(1);
    pct.textContent=Math.round(f*100);
  }
  var drag=false;
  grid.addEventListener('pointerdown',function(e){ drag=true; hit(e,true); });
  grid.addEventListener('pointermove',function(e){ if(drag) hit(e); });
  window.addEventListener('pointerup',function(){ drag=false; });
  function hit(e,toggle){
    var el=document.elementFromPoint(e.clientX,e.clientY);
    if(!el||el.parentNode!==grid) return;
    var on=el.getAttribute('aria-pressed')==='true';
    if(on && !toggle) return;
    el.setAttribute('aria-pressed', on?'false':'true'); upd();
  }
  /* detail===0 means the click came from the keyboard, so pointer painting
     above doesn't get immediately undone by a second toggle */
  /* roving tabindex: the grid is one tab stop, arrows move within it */
  cells.forEach(function(b,i){
    b.tabIndex = i===0 ? 0 : -1;
    b.addEventListener('click',function(e){
      if(e.detail!==0) return;
      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed')==='true'?'false':'true'); upd(); });
    b.addEventListener('keydown',function(e){
      var d={ArrowRight:1,ArrowLeft:-1,ArrowDown:COLS,ArrowUp:-COLS}[e.key];
      if(d===undefined) return;
      e.preventDefault();
      var j=Math.max(0,Math.min(n-1,i+d));
      cells[i].tabIndex=-1; cells[j].tabIndex=0; cells[j].focus();
    });
  });
  grid.setAttribute('role','grid');
  $$('[data-reset="roof"]').forEach(function(b){ b.addEventListener('click',function(){
    cells.forEach(function(c){c.setAttribute('aria-pressed','false');}); upd(); }); });
  upd();
})();

/* ---------- 03 · letting things come back ---------- */
(function(){
  var cv=$('#labRegen'), wrap=$('#regenToggles'); if(!cv||!wrap) return;
  var P=[{k:'graze',l:'Remove the grazing pressure',on:false},
         {k:'concrete',l:'Break up the concrete',on:false},
         {k:'drain',l:'Unblock the drainage',on:false}];
  var read=$('#regenRead'), rec=0;
  P.forEach(function(p,i){
    var b=document.createElement('button');
    b.type='button'; b.setAttribute('aria-pressed','false');
    b.innerHTML='<span>'+p.l+'</span><span class="st">Still there</span>';
    b.addEventListener('click',function(){
      p.on=!p.on; b.setAttribute('aria-pressed',p.on?'true':'false');
      b.lastChild.textContent=p.on?'Removed':'Still there';
    });
    wrap.appendChild(b);
  });
  var seeds=[]; for(var i=0;i<320;i++) seeds.push({x:Math.random(),y:Math.random(),s:Math.random(),t:Math.random()});
  reg(cv,function(x,w,h,t){
    var want=P.filter(function(p){return p.on;}).length/P.length;
    rec=lerp(rec,want,0.05); read.textContent=Math.round(rec*100);
    /* sky */
    var g=x.createLinearGradient(0,0,0,h*0.5);
    g.addColorStop(0,'#CBD9E3'); g.addColorStop(1,'#E7EDF1');
    x.fillStyle=g; x.fillRect(0,0,w,h);
    /* distant ridge */
    x.fillStyle='rgba(150,166,178,'+(0.34+rec*0.10)+')';
    x.beginPath(); x.moveTo(0,h*0.40);
    for(var rx=0;rx<=w;rx+=10) x.lineTo(rx,h*0.30-Math.abs(Math.sin(rx*0.008)+0.5*Math.sin(rx*0.021))*h*0.07);
    x.lineTo(w,h*0.44); x.closePath(); x.fill();
    /* slope */
    function land(px){ return h*0.34 + Math.sin(px*0.006)*h*0.05 + Math.sin(px*0.017+1.2)*h*0.028; }
    x.beginPath(); x.moveTo(0,h);
    for(var s=0;s<=w;s+=6) x.lineTo(s,land(s));
    x.lineTo(w,h); x.closePath();
    x.fillStyle= 'rgb('+Math.round(lerp(178,120,rec))+','+Math.round(lerp(140,146,rec))+','+Math.round(lerp(104,96,rec))+')';
    x.fill();
    /* erosion gullies fade as recovery rises */
    x.strokeStyle='rgba(120,86,52,'+(0.42*(1-rec))+')';
    for(var e=0;e<11;e++){
      var gx=(e+0.5)/11*w; x.lineWidth=1+((e*37)%3);
      x.beginPath(); x.moveTo(gx,land(gx));
      x.bezierCurveTo(gx+8,land(gx)+h*0.14,gx-14,land(gx)+h*0.28,gx+4,h);
      x.stroke();
    }
    /* vegetation */
    for(var i2=0;i2<seeds.length;i2++){
      var sd=seeds[i2];
      var thr=sd.t;
      if(rec<thr*0.95) continue;
      var gv=clamp((rec-thr*0.95)/0.25,0,1);
      var vx=sd.x*w, vy=land(vx)+sd.y*(h-land(vx))*0.92;
      var sway=Math.sin(t*0.0012+i2)*1.6*gv;
      var hgt=(6+sd.s*34)*gv*(0.42+ (vy-land(vx))/(h-land(vx)+1)*1.05);
      x.strokeStyle='rgba('+Math.round(70+sd.s*40)+','+Math.round(112+sd.s*46)+','+Math.round(66+sd.s*30)+',.85)';
      x.lineWidth=1+sd.s*1.6; x.lineCap='round';
      x.beginPath(); x.moveTo(vx,vy); x.quadraticCurveTo(vx+sway,vy-hgt*0.6,vx+sway*1.6,vy-hgt); x.stroke();
      if(sd.s>0.90){
        /* a shrub or a young tree */
        x.strokeStyle='rgba(62,54,40,.7)'; x.lineWidth=1.6+sd.s;
        x.beginPath(); x.moveTo(vx,vy); x.lineTo(vx+sway,vy-hgt*1.15); x.stroke();
        x.fillStyle='rgba(52,104,66,.68)';
        x.beginPath(); x.ellipse(vx+sway,vy-hgt*1.35,hgt*0.44,hgt*0.36,0,0,6.2832); x.fill();
      } else if(sd.s>0.80){
        x.fillStyle='rgba(70,124,80,.5)';
        x.beginPath(); x.arc(vx+sway*1.4,vy-hgt*0.9,hgt*0.28,0,6.2832); x.fill();
      }
    }
    /* the pressures, still present */
    if(!P[1].on){ x.fillStyle='rgba(158,158,158,.9)';
      x.fillRect(w*0.60,land(w*0.62)-3,w*0.34,h*0.09);
      x.fillStyle='rgba(128,128,128,.9)'; x.fillRect(w*0.60,land(w*0.62)-3,w*0.34,4); }
    if(!P[0].on){
      x.strokeStyle='rgba(70,60,50,.75)'; x.lineWidth=1.6;
      for(var f=0;f<10;f++){ var fx=w*0.04+f*w*0.052;
        x.beginPath(); x.moveTo(fx,land(fx)+h*0.06); x.lineTo(fx,land(fx)-h*0.09); x.stroke(); }
      x.beginPath(); x.moveTo(w*0.04,land(w*0.04)-h*0.06);
      x.lineTo(w*0.04+9*w*0.052,land(w*0.5)-h*0.06); x.stroke();
    }
    if(!P[2].on){ x.fillStyle='rgba(90,98,106,.92)';
      x.fillRect(0,land(0)+h*0.42,w,7);
      x.fillStyle='rgba(60,68,76,.6)'; x.fillRect(0,land(0)+h*0.42,w,2); }
    x.fillStyle='rgba(11,22,32,.35)'; x.font='10px "Space Grotesk",monospace';
    x.fillText(rec>0.98?'RECOVERED':(rec<0.02?'DEGRADED SLOPE':'RECOVERING'),12,18);
  });
})();

/* ---------- 04 · mechanisms ---------- */
(function(){
  var wrap=$('#mech'); if(!wrap) return;
  var M=[{l:'Binding phase-out schedule',w:30,f:'Targets become aspirations. Nothing has a deadline.'},
         {l:'Multilateral fund',w:22,f:'Developing countries carry the cost alone, and stop signing.'},
         {l:'Trade measures',w:18,f:'Production moves to whoever stayed outside the treaty.'},
         {l:'Independent monitoring',w:18,f:'CFC-11 keeps rising for a decade and nobody notices.'},
         {l:'Ratchet mechanism',w:12,f:'The treaty is frozen at 1987 ambition. No Kigali.'}];
  var read=$('#mechRead'), meter=$('#mechMeter'), note=$('#mechNote');
  M.forEach(function(m,i){
    var b=document.createElement('button');
    b.type='button'; b.setAttribute('aria-pressed','true');
    b.innerHTML='<span>'+m.l+'</span><span class="dot" aria-hidden="true"></span>';
    b.addEventListener('click',function(){
      m.off=!m.off; b.setAttribute('aria-pressed',m.off?'false':'true'); upd();
    });
    wrap.appendChild(b);
  });
  function upd(){
    var v=0, gone=[];
    M.forEach(function(m){ if(!m.off) v+=m.w; else gone.push(m.f); });
    read.textContent=v; meter.style.width=v+'%';
    meter.style.background = v>85?'var(--t-forest)': v>55?'var(--t-sun)':'var(--t-heat)';
    note.textContent = gone.length===0
      ? 'All five mechanisms in place. This is the configuration that closed the ozone hole.'
      : gone.join(' ');
  }
  upd();
})();

/* ---------- 05 · old cooling, reused ---------- */
(function(){
  var cv=$('#labCool'), sl=$('#coolSlide'); if(!cv||!sl) return;
  var read=$('#coolRead'), v=0, sv=0;
  sl.addEventListener('input',function(){ v=+sl.value/100;
    read.textContent = v<0.34?'Compressor' : (v<0.72?'Transition':'Terracotta'); });
  var parts=[]; for(var i=0;i<70;i++) parts.push({p:Math.random(),y:Math.random(),s:0.3+Math.random()*0.7});
  reg(cv,function(x,w,h,t){
    sv=lerp(sv,v,0.09);
    var bg=x.createLinearGradient(0,0,0,h);
    bg.addColorStop(0, sv<0.5?'#131A20':'#1A1512'); bg.addColorStop(1,'#080C10');
    x.fillStyle=bg; x.fillRect(0,0,w,h);
    var cx=w*0.5, cy=h*0.52;
    /* compressor */
    x.globalAlpha=clamp(1-sv*1.6,0,1);
    if(x.globalAlpha>0.01){
      var bw=w*0.42, bh=h*0.54, bx=cx-bw/2, by=cy-bh*0.54;
      /* casing */
      var mg=x.createLinearGradient(bx,by,bx+bw,by+bh);
      mg.addColorStop(0,'#5A666F'); mg.addColorStop(0.5,'#454F58'); mg.addColorStop(1,'#333C44');
      x.fillStyle=mg; x.fillRect(bx,by,bw,bh);
      x.fillStyle='#2C343B'; x.fillRect(bx,by,bw,bh*0.13);
      x.strokeStyle='#1E252B'; x.lineWidth=2; x.strokeRect(bx,by,bw,bh);
      /* louvres */
      x.strokeStyle='rgba(150,164,175,.75)'; x.lineWidth=1.4;
      for(var i2=0;i2<15;i2++){ var yy=by+bh*0.20+i2*bh*0.052;
        x.beginPath(); x.moveTo(bx+bw*0.06,yy); x.lineTo(bx+bw*0.94,yy); x.stroke(); }
      /* fan */
      var fx0=cx, fy0=by+bh*0.56, fr=Math.min(bw,bh)*0.30;
      x.fillStyle='rgba(20,26,31,.85)';
      x.beginPath(); x.arc(fx0,fy0,fr*1.12,0,6.2832); x.fill();
      x.save(); x.translate(fx0,fy0); x.rotate(t*0.006);
      x.fillStyle='#8E9AA3';
      for(var f=0;f<5;f++){
        x.save(); x.rotate(f*1.2566);
        x.beginPath(); x.moveTo(0,0);
        x.quadraticCurveTo(fr*0.7,-fr*0.30,fr,0);
        x.quadraticCurveTo(fr*0.7,fr*0.16,0,0); x.fill();
        x.restore();
      }
      x.restore();
      x.fillStyle='#C3CDD4'; x.beginPath(); x.arc(fx0,fy0,fr*0.17,0,6.2832); x.fill();
      /* feet + pipe */
      x.fillStyle='#2C343B';
      x.fillRect(bx+bw*0.08,by+bh,bw*0.10,h*0.035);
      x.fillRect(bx+bw*0.82,by+bh,bw*0.10,h*0.035);
      x.strokeStyle='#7D8891'; x.lineWidth=5; x.lineCap='round';
      x.beginPath(); x.moveTo(bx,by+bh*0.30); x.lineTo(bx-w*0.09,by+bh*0.30);
      x.lineTo(bx-w*0.09,by+bh*1.05); x.stroke();
      /* exhaust heat */
      x.globalAlpha*=0.7;
      for(var hh=0;hh<7;hh++){
        var hy=by+bh*0.22+hh*bh*0.10;
        var hg=x.createLinearGradient(bx+bw,hy,bx+bw+w*0.16,hy);
        hg.addColorStop(0,'rgba(255,120,50,.55)'); hg.addColorStop(1,'rgba(255,120,50,0)');
        x.strokeStyle=hg; x.lineWidth=2.4;
        x.beginPath(); x.moveTo(bx+bw+2,hy);
        for(var e=0;e<=8;e++) x.lineTo(bx+bw+2+e*w*0.02, hy+Math.sin(e*0.9+t*0.004+hh)*4);
        x.stroke();
      }
      x.globalAlpha=clamp(1-sv*1.6,0,1);
      x.fillStyle='rgba(255,130,80,.95)'; x.font='11px "Space Grotesk",monospace';
      x.fillText('HFC REFRIGERANT · GRID POWER', bx, by+bh+h*0.115);
    }
    /* terracotta wall */
    x.globalAlpha=clamp((sv-0.30)*1.7,0,1);
    if(x.globalAlpha>0.01){
      var cols=7, rows=5, cw=w*0.052;
      for(var r=0;r<rows;r++) for(var c=0;c<cols;c++){
        var ox=cx+(c-(cols-1)/2)*cw*1.62+(r%2?cw*0.81:0);
        var oy=cy+(r-(rows-1)/2)*cw*1.42;
        var gr=x.createRadialGradient(ox-cw*0.3,oy-cw*0.3,cw*0.1,ox,oy,cw);
        gr.addColorStop(0,'#C86B3E'); gr.addColorStop(0.6,'#9E4E2A'); gr.addColorStop(1,'#5E2C18');
        x.fillStyle=gr;
        x.beginPath(); x.arc(ox,oy,cw,0,6.2832); x.fill();
        x.fillStyle='#2A1208';
        x.beginPath(); x.arc(ox,oy,cw*0.42,0,6.2832); x.fill();
        x.strokeStyle='rgba(255,200,150,.25)'; x.lineWidth=1;
        x.beginPath(); x.arc(ox,oy,cw*0.42,0,6.2832); x.stroke();
      }
      x.fillStyle='rgba(140,214,232,.95)'; x.font='11px "Space Grotesk",monospace';
      x.fillText('WATER + AIRFLOW · NO REFRIGERANT', cx-w*0.20, cy+h*0.38);
    }
    x.globalAlpha=1;
    /* airflow */
    for(var p=0;p<parts.length;p++){
      var q=parts[p];
      q.p+=0.0016*(1+q.s)* (RM?0:1);
      if(q.p>1) q.p=0;
      var px=q.p*w, py=h*0.16+q.y*h*0.68;
      var warp=Math.sin(q.p*7+t*0.001)*8;
      var hot='rgba(255,'+Math.round(120+q.s*60)+',70,';
      var cool='rgba(150,'+Math.round(210+q.s*30)+',235,';
      x.strokeStyle=(sv<0.5?hot:cool)+(0.10+q.s*0.28)+')';
      x.lineWidth=0.8+q.s;
      x.beginPath(); x.moveTo(px,py+warp); x.lineTo(px+12+q.s*20,py+warp); x.stroke();
    }
  });
})();

requestAnimationFrame(loop);
window.addEventListener('resize',function(){
  clearTimeout(window.__labRT);
  window.__labRT=setTimeout(function(){ live.forEach(function(s){s.resize();}); },200);
},{passive:true});
window.__ICE.labsResize=function(){ live.forEach(function(s){s.resize();}); };
})();
</script>
