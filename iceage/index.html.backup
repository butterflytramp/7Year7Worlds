var PROJ=[
 {n:'Ahmedabad Heat Action Plan',loc:'Ahmedabad, Gujarat',when:'2013',tag:'Heat',lab:'AHMEDABAD',x:151.5,y:557.1,nx:0,ny:0,lx:28,ly:2,b:'South Asia\'s first. Colour-coded warnings, hospital readiness, water access and cool roofs. Estimated to avert around 1,190 deaths a year; the template has been copied across more than twenty states.'},
 {n:'Cool Roof Policy',loc:'Hyderabad, Telangana',when:'2023–28',tag:'Shade',lab:'HYDERABAD',x:354.0,y:762.8,nx:0,ny:0,lx:28,ly:6,b:'The first Indian state to mandate reflective roofs across government, commercial and non-residential buildings. Measured indoor reductions of 2.1–4.3 °C against conventional roofs.'},
 {n:'Johad revival',loc:'Alwar, Rajasthan',when:'1985–',tag:'Water',lab:'ALWAR',x:290.6,y:385.5,nx:0,ny:0,lx:32,ly:30,b:'Tarun Bharat Sangh rebuilt earthen check dams village by village. It claims some 13,800 harvesting structures and thirteen rejuvenated rivers; the Arvari, seasonal for decades, ran again, and 72 villages convened their own river parliament.'},
 {n:'Mandatory rainwater harvesting',loc:'Chennai, Tamil Nadu',when:'2003',tag:'Water',lab:'CHENNAI',x:415.1,y:915.4,nx:0,ny:0,lx:28,ly:4,b:'The state tied water connections and building approvals to a working rooftop system. After the heavy rains of 2005, wells recovered and groundwater rose close to twenty feet in parts of the city. Enforcement has since slipped — over 41,000 buildings were later found without one.'},
 {n:'Bhadla Solar Park',loc:'Phalodi district, Rajasthan',when:'2015–18',tag:'Sun',lab:'BHADLA',x:128.8,y:386.1,nx:0,ny:0,lx:-30,ly:-16,b:'2,245 MW across 56 km² of the Thar Desert, on land nobody wanted. Its main operational problem is dust.'},
 {n:'Aravalli Biodiversity Park',loc:'Gurugram, Haryana',when:'2012–',tag:'Forest',lab:'GURUGRAM',x:304.0,y:350.4,nx:0,ny:0,lx:-34,ly:-30,b:'A 380-acre quartzite mining pit replanted with native species by a citizens\' group. Now more than 300 plant species and 195 bird species, and India\'s first OECM conservation site (2022).'},
 {n:'Piplantri',loc:'Rajsamand, Rajasthan',when:'2006–',tag:'Forest',lab:'PIPLANTRI',x:195.3,y:480.3,nx:0,ny:0,lx:-28,ly:10,b:'The village plants 111 trees for every girl born, with a deposit held in her name. It began as one man\'s response to his daughter\'s death and became a working link between afforestation and the status of girls.'},
 {n:'International Solar Alliance',loc:'Gwal Pahari, Gurugram',when:'2015–',tag:'Agreement',lab:'GWAL PAHARI',x:308.2,y:351.9,nx:26,ny:-16,lx:34,ly:-8,b:'Launched by India and France in Paris, headquartered outside Delhi. Now over 120 member and signatory countries — the first treaty-based intergovernmental organisation headquartered in India. Shown slightly offset from Gurugram for legibility.'}
];

(function(){
  var svg=$('#indiaMap'); if(!svg) return;
  var cur=-1, groups=[], items=[];

  svg.innerHTML =
    '<defs>'+
      '<pattern id="hatch" width="5" height="5" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">'+
        '<line x1="0" y1="0" x2="0" y2="5" stroke="rgba(11,22,32,.13)" stroke-width="1"/></pattern>'+
      '<filter id="landsh" x="-8%" y="-8%" width="120%" height="120%">'+
        '<feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#0B1620" flood-opacity=".13"/></filter>'+
    '</defs>';

  var NS='http://www.w3.org/2000/svg';
  function el(t,at,parent){
    var e=document.createElementNS(NS,t);
    for(var k in at) e.setAttribute(k,at[k]);
    (parent||svg).appendChild(e); return e;
  }

  /* graticule, behind the land */
  var g0=el('g',{'class':'grat','aria-hidden':'true'});
  GEO.grat.v.forEach(function(v){
    el('line',{x1:v[1],y1:0,x2:v[1],y2:GEO.H},g0);
    el('text',{x:v[1]+4,y:14,'class':'gl'},g0).textContent=v[0]+'\u00B0E';
  });
  GEO.grat.h.forEach(function(v){
    el('line',{x1:0,y1:v[1],x2:GEO.W,y2:v[1]},g0);
    el('text',{x:4,y:v[1]-5,'class':'gl'},g0).textContent=v[0]+'\u00B0N';
  });

  /* land */
  var gl=el('g',{'class':'land',filter:'url(#landsh)'});
  GEO.paths.forEach(function(d){ el('path',{d:d},gl); });
  GEO.dots.forEach(function(p){ el('circle',{cx:p[0],cy:p[1],r:p[2]},gl); });

  var gm=el('g',{'class':'marks'});
  var panel={idx:$('#mpIdx'),name:$('#mpName'),tag:$('#mpTag'),loc:$('#mpLoc'),body:$('#mpBody')};
  var list=$('#mapList');

  PROJ.forEach(function(p,i){
    var g=el('g',{'class':'mk',tabindex:'0',role:'button',
      'aria-label':p.n+' \u2014 '+p.loc+', '+p.when+'. Category: '+p.tag},gm);
    var mx=p.x+p.nx, my=p.y+p.ny;
    if(p.nx||p.ny) el('line',{x1:p.x,y1:p.y,x2:mx,y2:my,'class':'tie'},g);
    var lx=mx+p.lx, ly=my+p.ly;
    el('line',{x1:mx,y1:my,x2:lx,y2:ly,'class':'lead'},g);
    el('circle',{cx:mx,cy:my,r:24,'class':'hit'},g);
    el('circle',{cx:mx,cy:my,r:19,'class':'foc'},g);
    el('circle',{cx:mx,cy:my,r:13,'class':'ring',stroke:TAGC[p.tag]},g);
    el('circle',{cx:mx,cy:my,r:6,'class':'dot',fill:TAGC[p.tag]},g);
    var num=String(i+1).padStart(2,'0');
    var t=el('text',{x:lx+(p.lx>0?7:-7),y:ly+5,'class':'lbl',
      'text-anchor':p.lx>0?'start':'end'},g);
    t.textContent=num+' \u00B7 '+p.lab;
    var t2=el('text',{x:lx+(p.lx>0?7:-7),y:ly+5,'class':'lbl lbl-s',
      'text-anchor':p.lx>0?'start':'end'},g);
    t2.textContent=num;
    g.addEventListener('click',function(){ sel(i); });
    g.addEventListener('mouseenter',function(){ sel(i); });
    g.addEventListener('focus',function(){ sel(i); });
    g.addEventListener('keydown',function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); sel(i); }
      else if(e.key==='ArrowRight'||e.key==='ArrowDown'){ e.preventDefault(); groups[(i+1)%groups.length].focus(); }
      else if(e.key==='ArrowLeft'||e.key==='ArrowUp'){ e.preventDefault(); groups[(i-1+groups.length)%groups.length].focus(); }
    });
    groups.push(g);

    var li=document.createElement('li');
    var btn=document.createElement('button');
    btn.type='button';
    btn.innerHTML='<i style="background:'+TAGC[p.tag]+'"></i>'+
      '<span class="ml-n">'+p.n+'</span>'+
      '<span class="ml-m">'+p.loc+' \u00B7 '+p.when+'</span>';
    btn.addEventListener('click',function(){ sel(i); groups[i].focus(); });
    btn.addEventListener('mouseenter',function(){ sel(i); });
    li.appendChild(btn); list.appendChild(li); items.push(btn);
  });

  function sel(i){
    if(i===cur) return; cur=i;
    var p=PROJ[i];
    groups.forEach(function(g,k){ g.setAttribute('aria-current', k===i?'true':'false'); });
    items.forEach(function(b,k){ b.setAttribute('aria-current', k===i?'true':'false'); });
    panel.idx.textContent=String(i+1).padStart(2,'0')+' / 08';
    panel.name.textContent=p.n;
    panel.tag.textContent=p.tag; panel.tag.style.background=TAGC[p.tag];
    panel.tag.style.color=(p.tag==='Sun'||p.tag==='Agreement')?'#0B1620':'#fff';
    panel.loc.textContent=p.loc+' \u00B7 '+p.when;
    panel.body.textContent=p.b;
  }
  $('#mpPrev').addEventListener('click',function(){ sel((cur-1+PROJ.length)%PROJ.length); });
  $('#mpNext').addEventListener('click',function(){ sel((cur+1)%PROJ.length); });
  sel(0);
})();

/* ---------- DESIGN A PLANET ---------- */
(function(){
  var host=$('#qs'); if(!host) return;
  var Q=[
   {k:'albedo',lab:'Albedo',q:'How much light do you send back?',
    o:[['Paint the roofs',1],['Re-freeze the ice',0.8],['Leave it',0]]},
   {k:'water',lab:'Water',q:'Where does the rain go?',
    o:[['Into the ground',1],['Into a tank you built by hand',0.85],['Into the river',0.15]]},
   {k:'canopy',lab:'Canopy',q:'What do you let grow back?',
    o:[['Native, slow',1],['Fast and uniform',0.45],['Nothing — stop the pressure and wait',0.8]]},
   {k:'agree',lab:'Agreement',q:'How do you make it stick?',
    o:[['A binding schedule and a fund',1],['A pledge',0.3],['Nothing',0]]}
  ];
  var chosen={};
  Q.forEach(function(q,qi){
    var d=document.createElement('div'); d.className='q';
    d.innerHTML='<h3>'+String(qi+1).padStart(2,'0')+' · '+q.lab+'</h3><p class="qq">'+q.q+'</p>';
    var wrap=document.createElement('div'); wrap.className='opts';
    wrap.setAttribute('role','group'); wrap.setAttribute('aria-label',q.lab+': '+q.q);
    q.o.forEach(function(o){
      var b=document.createElement('button');
      b.type='button'; b.setAttribute('aria-pressed','false'); b.textContent=o[0];
      b.addEventListener('click',function(){
        $$('button',wrap).forEach(function(z){z.setAttribute('aria-pressed','false');});
        b.setAttribute('aria-pressed','true');
        K.CHOICE[q.k]=o[1]; chosen[q.k]=o[0].toLowerCase(); out();
      });
      wrap.appendChild(b);
    });
    d.appendChild(wrap); host.appendChild(d);
  });
  var el=$('#dpOut');
  function out(){
    var n=Object.keys(chosen).length;
    if(n<4){ el.innerHTML='Four decisions. <b>'+n+' of 4</b> made.'; return; }
    el.innerHTML='You built a planet that is <b>'+chosen.albedo+'</b>, sends its rain <b>'+chosen.water+
      '</b>, grows back <b>'+chosen.canopy+'</b>, and holds it together with <b>'+chosen.agree+
      '</b>. Every one of those already exists somewhere. None of them exists everywhere.';
  }
  out();
})();

/* ---------- SOUND ---------- */
var Sound=(function(){
  var ctx=null, master=null, on=false, nodes={}, groanT=0;
  function noiseBuf(){
    var n=ctx.sampleRate*3, b=ctx.createBuffer(1,n,ctx.sampleRate), d=b.getChannelData(0);
    for(var i=0;i<n;i++) d[i]=Math.random()*2-1;
    return b;
  }
  function build(){
    var AC=window.AudioContext||window.webkitAudioContext; if(!AC) return false;
    ctx=new AC();
    master=ctx.createGain(); master.gain.value=0; master.connect(ctx.destination);
    var buf=noiseBuf();
    /* wind */
    var w=ctx.createBufferSource(); w.buffer=buf; w.loop=true;
    var wf=ctx.createBiquadFilter(); wf.type='bandpass'; wf.frequency.value=420; wf.Q.value=0.7;
    var wg=ctx.createGain(); wg.gain.value=0.32;
    w.connect(wf); wf.connect(wg); wg.connect(master); w.start();
    var lfo=ctx.createOscillator(); lfo.frequency.value=0.07;
    var lg=ctx.createGain(); lg.gain.value=240;
    lfo.connect(lg); lg.connect(wf.frequency); lfo.start();
    /* meltwater */
    var m=ctx.createBufferSource(); m.buffer=buf; m.loop=true;
    var mf=ctx.createBiquadFilter(); mf.type='bandpass'; mf.frequency.value=2100; mf.Q.value=3.5;
    var mg=ctx.createGain(); mg.gain.value=0;
    m.connect(mf); mf.connect(mg); mg.connect(master); m.start();
    /* fire hum */
    var fg=ctx.createGain(); fg.gain.value=0; fg.connect(master);
    [58,87,116.5].forEach(function(f,i){
      var o=ctx.createOscillator(); o.type=i===0?'sine':'triangle'; o.frequency.value=f;
      var g=ctx.createGain(); g.gain.value=i===0?0.5:0.16;
      o.connect(g); g.connect(fg); o.start();
    });
    /* sub drone */
    var sub=ctx.createOscillator(); sub.type='sine'; sub.frequency.value=41;
    var sg=ctx.createGain(); sg.gain.value=0.22; sub.connect(sg); sg.connect(master); sub.start();
    nodes={wf:wf,wg:wg,mg:mg,fg:fg,sg:sg};
    return true;
  }
  function groan(){
    if(!ctx) return;
    var o=ctx.createOscillator(), g=ctx.createGain(), f=ctx.createBiquadFilter();
    o.type='sawtooth'; f.type='lowpass'; f.frequency.value=180; f.Q.value=6;
    var base=48+Math.random()*40;
    o.frequency.setValueAtTime(base,ctx.currentTime);
    o.frequency.exponentialRampToValueAtTime(base*0.62,ctx.currentTime+2.4);
    g.gain.setValueAtTime(0,ctx.currentTime);
    g.gain.linearRampToValueAtTime(0.22,ctx.currentTime+0.5);
    g.gain.linearRampToValueAtTime(0,ctx.currentTime+2.6);
    o.connect(f); f.connect(g); g.connect(master); o.start(); o.stop(ctx.currentTime+2.8);
  }
  function toggle(){
    if(!ctx && !build()) return false;
    if(ctx.state==='suspended') ctx.resume();
    on=!on;
    master.gain.cancelScheduledValues(ctx.currentTime);
    master.gain.linearRampToValueAtTime(on?0.30:0, ctx.currentTime+0.9);
    return on;
  }
  function update(S){
    if(!ctx||!on) return;
    var t=ctx.currentTime, j=S.sj;
    nodes.wg.gain.setTargetAtTime(0.34*(1-K.smoo(0.30,0.55,j))+0.05, t, 0.6);
    nodes.wf.frequency.setTargetAtTime(360+ j*520, t, 0.8);
    nodes.mg.gain.setTargetAtTime(0.10*K.smoo(0.62,0.92,j)*(1-S.mode), t, 0.8);
    nodes.fg.gain.setTargetAtTime(0.11*S.fire, t, 0.5);
    nodes.sg.gain.setTargetAtTime(0.10+0.24*K.smoo(0.28,0.62,j), t, 0.7);
    if(j>0.32&&j<0.80&&performance.now()>groanT){ groanT=performance.now()+4000+Math.random()*9000; groan(); }
  }
  return {toggle:toggle,update:update,active:function(){return on;}};
})();

(function(){
  var b=$('#snd'), l=$('#sndLbl'); if(!b) return;
  b.addEventListener('click',function(){
    var s=Sound.toggle();
    b.classList.toggle('on',!!s); b.setAttribute('aria-pressed',s?'true':'false');
    l.textContent=s?'Sound on':'Sound off';
  });
  setInterval(function(){ Sound.update(K.S); },220);
})();

/* ---------- BOOT ---------- */
(function(){
  var bar=$('#loader .load-bar i'), num=$('#loadNum'), ld=$('#loader'), p=0, done=false;
  function set(v){ p=Math.max(p,v); bar.style.width=p+'%'; num.textContent=Math.round(p); }
  var iv=setInterval(function(){ set(Math.min(92,p+3+Math.random()*7)); },90);
  function finish(){
    if(done) return; done=true;
    clearInterval(iv); set(100);
    setTimeout(function(){
      ld.classList.add('done');
      setTimeout(function(){ ld.style.display='none'; },1200);
    },260);
  }
  function go(){
    try{ K.plates(); }catch(e){ console.warn('plates',e); }
    try{ K.boot(); }catch(e){ console.warn('boot',e); K.glFallback(); }
    setTimeout(function(){ K.measure(); K.labsResize&&K.labsResize(); },120);
    finish();
  }
  if(document.fonts&&document.fonts.ready){
    document.fonts.ready.then(go).catch(go);
    setTimeout(go,3000);
  } else if(document.readyState!=='loading'){ go(); }
  else window.addEventListener('DOMContentLoaded',go);
})();
})();
</script>
</body>
</html>
