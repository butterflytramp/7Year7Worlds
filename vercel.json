{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/iceage", "destination": "/iceage/index.html" }
  ],
  "headers": [
    { "source": "/Y2K/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/RetroGames/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
